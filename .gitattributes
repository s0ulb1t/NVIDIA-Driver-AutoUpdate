# Normalize line endings in the repository; check out as CRLF on Windows.
* text=auto

# PowerShell and Markdown: keep Windows line endings in working copies.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.md text eol=lf
LICENSE text eol=lf

# Binary files
*.exe binary
*.intunewin binary
